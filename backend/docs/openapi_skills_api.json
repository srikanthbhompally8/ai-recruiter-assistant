  "paths": {
    "/api/v1/skills/match": {
      "post": {
        "tags": [
          "skills"
        ],
        "summary": "Match Candidate Skills",
        "description": "Match candidate skills to job requirements.\n\nRequest body:\n{\n    \"candidate_id\": \"uuid\",\n    \"job_id\": \"uuid\"\n}\n\nReturns:\n    Detailed skill match analysis with scoring breakdown",
        "operationId": "match_candidate_skills_api_v1_skills_match_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Match Candidate Skills Api V1 Skills Match Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/skills/rank": {
      "post": {
        "tags": [
          "skills"
        ],
        "summary": "Rank Candidates By Skills",
        "description": "Rank candidates by skill match for a specific job.\n\nRequest body:\n{\n    \"job_id\": \"uuid\",\n    \"limit\": 10,\n    \"min_score\": 0.6\n}\n\nReturns:\n    Ranked list of candidates with skill match scores",
        "operationId": "rank_candidates_by_skills_api_v1_skills_rank_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Rank Candidates By Skills Api V1 Skills Rank Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/skills/gaps": {
      "post": {
        "tags": [
          "skills"
        ],
        "summary": "Analyze Skills Gaps",
        "description": "Analyze skills gaps between candidate and job requirements.\n\nRequest body:\n{\n    \"candidate_id\": \"uuid\",\n    \"job_id\": \"uuid\"\n}\n\nReturns:\n    Detailed gap analysis with prioritized missing skills",
        "operationId": "analyze_skills_gaps_api_v1_skills_gaps_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Analyze Skills Gaps Api V1 Skills Gaps Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
